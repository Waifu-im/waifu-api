DISCORD_TOKEN=your-bot-token-here

# optional overrides
PREFIX=!

# The Cloudflare Worker. It caches anonymous reads at the edge for 60s, so it is
# faster and survives Render free-tier cold starts. Point it at
# https://waifu-api-031n.onrender.com to bypass the cache and hit the API host.
WAIFU_API=https://waifu-cdn.waifu-api.workers.dev

# Extra channel IDs allowed to receive NSFW results.
# Only needed for channels NOT marked age-restricted in Discord itself.
NSFW_CHANNELS=