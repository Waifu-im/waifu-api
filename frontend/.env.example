VITE_DISCORD_CLIENT_ID="your-discord-client-id"
VITE_DISCORD_REDIRECT_URI="http://localhost:5173/auth/callback"

# On-the-fly image resizing for thumbnails/cards (e.g. Cloudflare Image Resizing).
# Off by default; the original full-res image is served everywhere until enabled.
# Enabling requires VITE_IMG_TRANSFORM_PATH to be set (it has no default).
VITE_IMG_TRANSFORM_ENABLED="false"
# Prefix inserted after the origin. For Cloudflare fold extra options here (trailing comma optional):
#   "/cdn-cgi/image/format=auto"            keeps GIF/WebP animating in thumbnails (resized only)
#   "/cdn-cgi/image/format=auto,anim=false" freezes thumbnails to a static first frame (lighter)
# The image detail page always serves the untransformed original, so animations play in full there.
VITE_IMG_TRANSFORM_PATH=""
VITE_IMG_WIDTH_PARAM="width"
VITE_IMG_CARD_WIDTH="640"
VITE_IMG_PREVIEW_WIDTH="1280"
