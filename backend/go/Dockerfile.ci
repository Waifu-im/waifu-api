# Build context for the Go backend.
#
# Only the Go module is needed. Excluding the C# sources keeps the build context
# small and makes it impossible to accidentally depend on a file from the
# service being replaced.

# ---- Test -----------------------------------------------------------------
# Unit tests, including the perceptual-hash package. The corpus-backed tests
# skip themselves when PHASH_CORPUS_DIR is absent, which is the case in CI by
# default; the deterministic tests always run.
FROM golang:1.27-alpine AS test
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go vet ./... && go test ./...

# ---- Build ----------------------------------------------------------------
FROM golang:1.27-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=0.0.0-local
RUN CGO_ENABLED=0 GOOS=linux go build \
      -trimpath \
      -ldflags="-s -w -X main.version=${VERSION}" \
      -o /out/server \
      ./cmd/server

# ---- Runtime --------------------------------------------------------------
# Must match the runtime stage of ./Dockerfile. See that file for why this is
# base rather than static: the alpine build stage produced a musl binary that
# could not start here, and the WebP encoder keeps the binary dynamically
# linked even under CGO_ENABLED=0.
FROM gcr.io/distroless/base-debian12:nonroot

COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /out/server /server

USER nonroot:nonroot
EXPOSE 8080

ENTRYPOINT ["/server"]